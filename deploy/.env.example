# setup-vps.sh copies the old /opt/ticket-booking/.env (or this file) to /etc/ticket-booking/app.env
# (root:ticketbooking, 640). Loaded by the systemd unit as environment variables. Never commit the real file.

# Database
DB_URL=jdbc:postgresql://127.0.0.1:5432/ticketbooking
DB_USERNAME=
DB_PASSWORD=

JWT_SECRET=
CLOUDINARY_URL=

MAIL_USERNAME=
MAIL_PASSWORD=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
PAYMENT_SUCCESS_URL=
PAYMENT_ERROR_URL=

VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_RETURN_URL=
MOMO_NOTIFY_URL=

GEMINI_API_KEY=
GEMINI_MODEL=
