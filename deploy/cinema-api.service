# Installed to /etc/systemd/system/cinema-api.service by setup-vps.sh
[Unit]
Description=Cinema Ticket Booking API (Spring Boot)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=cinema
Group=cinema
WorkingDirectory=/opt/cinema
# Secrets (DB credentials, JWT secret, API keys) live only on the VPS, never in the repo
EnvironmentFile=/etc/cinema/cinema.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -jar /opt/cinema/app.jar
# JVM exits with 143 on SIGTERM
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cinema/logs

[Install]
WantedBy=multi-user.target
